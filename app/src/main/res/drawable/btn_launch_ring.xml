<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- внешнее свечение -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="52dp"
                android:startColor="#4019B8E6"
                android:endColor="#0019B8E6" />
        </shape>
    </item>
    <!-- основной круг с обводкой -->
    <item
        android:left="7dp"
        android:top="7dp"
        android:right="7dp"
        android:bottom="7dp">
        <shape android:shape="oval">
            <solid android:color="#E6141D2E" />
            <stroke
                android:width="2dp"
                android:color="@color/accent_blue" />
        </shape>
    </item>
</layer-list>
